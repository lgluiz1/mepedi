# ==============================================================================
# MePedi - Variáveis de Ambiente (.env.example)
#
# Instruções:
# 1. Copie este arquivo para .env no seu ambiente: cp .env.example .env
# 2. Defina os valores apropriados para o seu ambiente (produção ou desenvolvimento).
# 3. NUNCA envie o arquivo .env com credenciais reais para o repositório Git.
# ==============================================================================

# Modo de Depuração (Defina False em Produção, True em Desenvolvimento)
DEBUG=False

# Chave Secreta do Django (Gere uma string longa e aleatória para produção)
SECRET_KEY=change-me-to-a-secure-random-secret-key

# Hosts Permitidos (Separados por vírgula)
# Em produção, adicione o IP da VPS e seu domínio/subdomínio:
# Exemplo: ALLOWED_HOSTS=mepedi.seudominio.com.br,127.0.0.1,localhost
ALLOWED_HOSTS=*

# Conexão com o Banco de Dados PostgreSQL Central da VPS (via rede Docker database_net)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_BANCO
# - Host na VPS: postgres (nome do container central na rede database_net)
# - Porta padrão: 5432
# - Banco e Usuário: mepedi
DATABASE_URL=postgresql://mepedi:change-me@postgres:5432/mepedi

# Configurações de Segurança HTTP Strict Transport Security (HSTS) para Produção (Opcional)
# Ativo automaticamente apenas quando DEBUG=False. Padrão: 31536000 (1 ano)
# SECURE_HSTS_SECONDS=31536000
