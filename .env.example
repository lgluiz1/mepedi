# Configurações do Django
DEBUG=True
SECRET_KEY=django-insecure-mvp-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Banco de Dados PostgreSQL (padrão no Docker ou PostgreSQL local)
# Exemplo Docker: postgres://postgres:postgres@db:5432/ia_pedidos
# Exemplo Local: postgres://postgres:postgres@localhost:5432/ia_pedidos
# Se vazio, usa sqlite3 para testes rápidos/desenvolvimento
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ia_pedidos

# Credenciais Docker
POSTGRES_DB=ia_pedidos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
